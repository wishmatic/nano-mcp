# Server (optional)

HOST=0.0.0.0
PORT=8080

LOG_LEVEL=info # debug, info, warn, error, dpanic, panic, fatal

# Auth

# Required. Every /mcp request must carry it as "Authorization: Bearer <API_KEY>".

API_KEY=change-me

# nano-gpt

# Required. Funds every tool call; the server refuses to start without it.

NANOGPT_API_KEY=

# Optional. Defaults to https://nano-gpt.com. Point it at a mirror domain to change where
# tool calls are billed and routed.

NANOGPT_BASE_URL=
