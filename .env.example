# Server (optional)

HOST=0.0.0.0
PORT=8080

LOG_LEVEL=info # debug, info, warn, error, dpanic, panic, fatal

# Auth

API_KEY=change-me

# nano-gpt

NANOGPT_API_KEY=

# File hosting

PUBLIC_HOST=https://nano-mcp.example.com
FILES_DIR=files # "files" resolves to /data/files

# Input address map

# Comma-separated public=private pairs, where the private side is an absolute http(s) base URL
# or a directory. This is how generate_image and generate_video read the images they are handed
# an address for: an image on this machine, or on a host (elfu-mcp, neo-mcp, a chat front end)
# nano-gpt cannot reach. A caller names the public side as the tool's `image`.
#
# A directory entry's public side is the only access control for that directory, so make it
# unguessable; the private side is never logged.
#
# A chat front end's uploads, with its images directory mounted:
# IMAGE_URL_MAP=https://chat.example.com/images/=/data/librechat-data
#
# Another MCP server's images, reached without a network hop, by mapping its host to the files
# directory its URLs are served from (elfu-mcp keeps images at /i/... under its own):
# IMAGE_URL_MAP=https://elfu.example.com=/data/elfu/files
#
# A public host an image is served from, reached under another name:
# IMAGE_URL_MAP=https://images.example.com=http://images:5080

IMAGE_URL_MAP=
